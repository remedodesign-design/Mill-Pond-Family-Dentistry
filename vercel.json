{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/home", "destination": "/", "permanent": true },
    { "source": "/index", "destination": "/", "permanent": true },
    { "source": "/dev", "destination": "/", "permanent": true },
    { "source": "/dev/home", "destination": "/", "permanent": true },
    { "source": "/dev/wireframe-:page", "destination": "/wireframes/:page", "permanent": true },
    { "source": "/dev/:page(about|contact|services|service-detail|team|style-guide)", "destination": "/Pages/:page", "permanent": true },
    { "source": "/dev/:path*", "destination": "/:path*", "permanent": true },
    { "source": "/:page(about|contact|services|service-detail|team|style-guide)", "destination": "/Pages/:page", "permanent": true },
    { "source": "/pages/:page*", "destination": "/Pages/:page*", "permanent": true }
  ]
}
