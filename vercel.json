{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/home", "destination": "/", "permanent": true },
    { "source": "/index", "destination": "/", "permanent": true },
    { "source": "/dev", "destination": "/", "permanent": true },
    { "source": "/dev/home", "destination": "/", "permanent": true },
    { "source": "/dev/wireframe-:page", "destination": "/wireframes/:page", "permanent": true },
    { "source": "/dev/:path*", "destination": "/:path*", "permanent": true },
    { "source": "/Pages", "destination": "/", "permanent": true },
    { "source": "/pages", "destination": "/", "permanent": true },
    { "source": "/Pages/:path*", "destination": "/:path*", "permanent": true },
    { "source": "/pages/:path*", "destination": "/:path*", "permanent": true }
  ]
}
